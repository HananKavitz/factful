# OpenRouter key (single key for all chat agents)
LLM_API_KEY=

# Tavily search
TAVILY_API_KEY=

# Embedding model key if separate from OpenRouter
EMBEDDINGS_API_KEY=

# Substack session cookie for draft push (wins over substack.toml)
SUBSTACK_SESSION_COOKIE=

# Pipeline verbosity (debug | info | warning)
LOG_LEVEL=info

# --- Web app (overrides config/settings.yaml [web]) ---

# SQLite by default; use a libsql:// URL for Turso in production
DATABASE_URL=sqlite:///./factful.db

# Auth: google | mock (mock is dev-only, fail-fast gated)
AUTH_MODE=google

# Secret used to sign session cookies (required in production)
SESSION_SECRET=

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turso auth token (only when DATABASE_URL is a libsql:// URL)
TURSO_AUTH_TOKEN=